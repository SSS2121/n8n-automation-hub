      "parameters": {
        "jsCode": "// 1. Creamos un Set para almacenar valores únicos\nconst vendedoresUnicos = new Set();\n\n// 2. Iteramos sobre los items que recibe el nodo\nfor (const item of $input.all()) {\n  const seller = item.json.seller;\n  \n  // Si el campo existe, lo añadimos al Set\n  if (seller) {\n    vendedoresUnicos.add(seller);\n  }\n}\n\n// 3. n8n espera un array de objetos, así que convertimos el Set\n// y lo mapeamos al formato correcto [{ json: { seller: '...' } }]\nreturn Array.from(vendedoresUnicos).map(seller => {\n  return {\n    json: {\n      seller: seller\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
