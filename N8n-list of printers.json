      "parameters": {
        "jsCode": "// 1. Rescatamos el array original con los datos intactos desde el nodo HTML\nconst datosOriginales = $('HTML').all(); \n\n// 2. Tomamos el array actual (los PDFs que acabamos de descargar)\nconst pdfsDescargados = $input.all(); \n\nlet resultado = [];\n\n// 3. Unimos manualmente el Índice 0 con el Índice 0, el 1 con el 1, etc.\nfor (let i = 0; i < pdfsDescargados.length; i++) {\n    \n    // Extraemos el PDF binario del ítem actual\n    const buffer = await this.helpers.getBinaryDataBuffer(i, 'data');\n    \n    // Construimos un JSON completamente nuevo y limpio\n    resultado.push({\n        json: {\n            // Datos para PrintNode\n            printerId: datosOriginales[i].json.printerId, \n            title: datosOriginales[i].json.description, \n            contentType: \"pdf_base64\",\n            content: buffer.toString('base64'),\n            \n            // Datos para la Base de Datos (Postgres)\n            id_factura: datosOriginales[i].json.id_facturas,\n            producto_codigo: datosOriginales[i].json.code\n        }\n    });\n}\n\nreturn resultado;"
      },
